; Shire Journey 3D - native Godot migration; no HTML dependency.
config_version=5

[application]
config/name="Shire Journey - Chapter I"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.69,0.81,0.79,1)

[physics]
3d/default_gravity=16.0

[input]
move_forward={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
interact={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
camera_toggle={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":86)]}
jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
menu={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
save_game={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194339)]}